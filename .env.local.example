# ==========================================================================
# XOS — environment variables
# Copy to `.env.local` for local dev, and set the same keys in Netlify
# (Site settings → Environment variables) for production.
# NEVER commit real values. NEXT_PUBLIC_* are exposed to the browser.
# ==========================================================================

# ---- Core (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-only; bypasses RLS
NEXT_PUBLIC_APP_URL=https://xos.xpressdjs.com  # prod domain; http://localhost:3000 in dev

# ---- Email — Mailgun (PRIMARY delivery, required for client mail) --------
MAILGUN_API_KEY=<mailgun-api-key>
MAILGUN_DOMAIN=xpressdjs.com          # or mg.xpressdjs.com
MAILGUN_REGION=us                     # us | eu
MAIL_FROM=Xpress Entertainment <events@xpressdjs.com>
MAILGUN_SIGNING_KEY=<webhook-signing-key>   # verifies delivery/bounce webhooks

# ---- Email/SMS — HighLevel (fallback delivery + Comms threading) ---------
HIGHLEVEL_PI_TOKEN=<private-integration-token>
HIGHLEVEL_LOCATION_ID=<location-id>
# Marketplace-app OAuth (optional — threads Mailgun-sent mail into GHL Comms)
GHL_MARKETPLACE_CLIENT_ID=<marketplace-client-id>
GHL_MARKETPLACE_CLIENT_SECRET=<marketplace-client-secret>
HIGHLEVEL_CONVERSATION_PROVIDER_ID=<conversation-provider-id>

# ---- Payments — PayPal (required for card payments) ----------------------
PAYPAL_ENV=sandbox                    # sandbox | live  (MUST be 'live' in prod)
PAYPAL_CLIENT_ID=<paypal-client-id>
PAYPAL_CLIENT_SECRET=<paypal-client-secret>
NEXT_PUBLIC_PAYPAL_CLIENT_ID=<paypal-client-id>   # same id, exposed for the on-page buttons
PAYPAL_WEBHOOK_ID=<paypal-webhook-id>             # enables webhook signature verification

# ---- Jobs & security -----------------------------------------------------
CRON_SECRET=<random-long-string>      # Bearer token for /api/cron/* + machine endpoints
ORIGIN_VERIFY_SECRET=<random-string>  # Cloudflare origin lock (inert until set)
UNSUBSCRIBE_SECRET=<random-string>    # optional; falls back to CRON_SECRET / service key
OWNER_EMAILS=drew@xpressdjs.com       # comma-separated break-glass owner logins

# ---- AI assistant --------------------------------------------------------
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5.5                  # optional override

# ---- Music search (planner) ----------------------------------------------
SPOTIFY_CLIENT_ID=<spotify-client-id>
SPOTIFY_CLIENT_SECRET=<spotify-client-secret>
SPOTIFY_REDIRECT_URI=https://xos.xpressdjs.com/api/spotify/callback
YOUTUBE_API_KEY=<youtube-data-api-key>
APPLE_MUSIC_STOREFRONT=us
APPLE_MUSIC_TEAM_ID=<apple-team-id>
APPLE_MUSIC_KEY_ID=<apple-key-id>
APPLE_MUSIC_PRIVATE_KEY=<apple-musickit-private-key>

# ---- Other integrations --------------------------------------------------
GOOGLE_MAPS_API_KEY=<places-api-key>          # venue/address autocomplete
TEMPLATESBOOTH_API_KEY=<templatesbooth-key>   # photo-booth design catalog
CLIENT_APP_REDIRECT=xpressclient://auth/set-password  # native app deep link (http(s) only is honored for web)

# ---- Local tooling (dev only) --------------------------------------------
# CHROME_PATH=/path/to/chrome                 # PDF rendering, if not auto-detected
# SUPABASE_DB_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres  # npm run db:snapshot
